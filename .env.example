# Copia este archivo a .env y rellena tus datos. .env NO se sube a GitHub.

# Buzón que recibe los correos (ejemplo: Gmail)
IMAP_HOST=imap.gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_USUARIO=buzon@tuempresa.com
# En Gmail usa una "contraseña de aplicación", no tu contraseña normal
EMAIL_CLAVE=tu-contraseña-de-aplicacion

# A dónde se reenvía cada departamento (deben ser distintos de EMAIL_USUARIO)
DESTINO_SOPORTE=soporte@tuempresa.com
DESTINO_FACTURACION=facturacion@tuempresa.com
DESTINO_VENTAS=ventas@tuempresa.com
DESTINO_RRHH=rrhh@tuempresa.com
DESTINO_GENERAL=info@tuempresa.com

INTERVALO_SEGUNDOS=60
